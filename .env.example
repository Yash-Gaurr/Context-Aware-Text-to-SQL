# ===================================================
# Context-Aware Text-to-SQL Configuration
# ===================================================

# 1. Gemini API Key (FREE tier: https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Preferred Reasoning Backend (Optional: auto | gemini | openrouter | openai | claude | rule)
# 'auto' automatically prioritizes GEMINI_API_KEY if present.
REASONER=gemini

# 3. Model Configuration (Optional: defaults to gemini-flash-latest)
# TEXT2SQL_MODEL=gemini-flash-latest
# TEXT2SQL_MAX_OUTPUT_TOKENS=2048

# 4. Port Configuration (Optional: default 5000)
PORT=5000
